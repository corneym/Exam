<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>au.edu.eq</groupId>
	<artifactId>exam-question-bank</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Exam Question Bank</name>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
		<junit.version>6.0.3</junit.version>
		<maven.surefire.plugin.version>3.5.5</maven.surefire.plugin.version>
		<javafx.version>25.0.4</javafx.version>
		<apache.poi.version>5.5.1</apache.poi.version>
		<testfx.version>4.0.18</testfx.version>
		<sqlite.jdbc.version>3.53.2.1</sqlite.jdbc.version>
		<test.suite>**/AllTests.java</test.suite>
		<headless.test.jvm.args></headless.test.jvm.args>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-swing</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${apache.poi.version}</version>
		</dependency>

		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>2.24.3</version>
		</dependency>

		<dependency>
			<groupId>org.testfx</groupId>
			<artifactId>testfx-junit5</artifactId>
			<version>${testfx.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>${sqlite.jdbc.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.plugin.version}</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<configuration>
					<includes>
						<include>${test.suite}</include>
					</includes>

					<argLine>
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.model=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.pdf=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.repository.sqlite=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.repository.curriculum=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.repository.assessment=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.output=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.importer.curriculum=ALL-UNNAMED
						--add-opens
						au.edu.eq.questionbank/au.edu.eq.questionbank.ui=ALL-UNNAMED
						${headless.test.jvm.args}
						--add-exports
						javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
						--add-opens
						javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
						--enable-native-access=javafx.graphics,ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>ui-tests</id>
			<properties>
				<test.suite>**/UITests.java</test.suite>
			</properties>
		</profile>

		<profile>
			<id>headless-ui-tests</id>

			<properties>
				<test.suite>**/UITests.java</test.suite>
				<headless.test.jvm.args>
					--add-exports javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
					--add-opens javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
					--add-exports javafx.graphics/com.sun.javafx.util=ALL-UNNAMED
					--add-exports javafx.base/com.sun.javafx.logging=ALL-UNNAMED
				</headless.test.jvm.args>
			</properties>

			<dependencies>
				<dependency>
					<groupId>org.testfx</groupId>
					<artifactId>openjfx-monocle</artifactId>
					<version>21.0.2</version>
					<scope>test</scope>
				</dependency>
			</dependencies>

			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<java.awt.headless>true</java.awt.headless>
								<testfx.robot>glass</testfx.robot>
								<testfx.headless>true</testfx.headless>
								<prism.order>sw</prism.order>
								<headless.geometry>1920x1080-32</headless.geometry>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
